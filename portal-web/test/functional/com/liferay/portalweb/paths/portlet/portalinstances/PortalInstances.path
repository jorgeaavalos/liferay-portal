<html>
<head>
<title>PortalInstances</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PortalInstances</td></tr>
</thead>

<tbody>

<!--INSTANCE_TABLE-->

<tr>
	<td>INSTANCE_TABLE_WEB_ID</td>
	<td>//tr/td[2]//a[contains(.,'${key_virtualHost}')]</td>
	<td></td>
</tr>
<tr>
	<td>INSTANCE_TABLE_VIRTUAL_HOST</td>
	<td>//tr/td[3]//a[contains(.,'${key_virtualHost}')]</td>
	<td></td>
</tr>
<tr>
	<td>INSTANCE_TABLE_MAIL_DOMAIN</td>
	<td>//tr/td[4]//a[contains(.,'${key_virtualHost}')]</td>
	<td></td>
</tr>

<!--INSTANCE_CREATION-->

<tr>
	<td>INSTANCE_CREATION_ALERT</td>
	<td>//div[contains(@class,'alert') and contains(@class,'alert-info') and not(contains(@class,'hide'))][contains(.,'The instance ${key_webId} is being created. You will be notified when it finishes.')] | //div[contains(@class,'alert-success')][contains(@class,'alert-dismissible')] | //div[contains(@class,'alert-success')][contains(@class,'alert-dismissable')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>